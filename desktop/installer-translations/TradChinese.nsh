!insertmacro LANGFILE_EXT "${YAB_TRANSLATION_LANGUAGE}"

${LangFileString} yabWelcomeTitle "歡迎使用 ${YAB_DISPLAY_NAME} 安裝程式"
${LangFileString} yabOpenApp "開啟 YAB"
${LangFileString} yabUnWelcomeTitle "歡迎使用 ${YAB_DISPLAY_NAME} 解除安裝程式"
${LangFileString} yabDirectoryTitle "選擇安裝位置"
${LangFileString} yabDirectorySubtitle "選擇 ${YAB_DISPLAY_NAME} 的安裝資料夾。"
${LangFileString} yabDirectoryText "安裝程式將把 ${YAB_DISPLAY_NAME} 安裝到以下目錄。要安裝到其他目錄，請按 [瀏覽(B)...] 並選擇其他的資料夾。$(^ClickInstall)"
${LangFileString} yabDirectoryGroup "安裝目錄"
${LangFileString} yabDirectoryInvalid "請填寫完整的安裝目錄。"
${LangFileString} yabDataTitle "應用程式資料"
${LangFileString} yabDataSubtitle "選擇移除後是否保留設定和執行資料。"
${LangFileString} yabKeepData "保留應用程式資料（建議）"
${LangFileString} yabKeepDataText "保留設定、記錄、執行環境和備份，重新安裝後可繼續使用。$\r$\n$\r$\n取消勾選將全部刪除。"
${LangFileString} yabChecking "正在檢查 YAB 執行狀態…"
${LangFileString} yabInstalling "正在安裝"
${LangFileString} yabPreparing "正在準備安裝…"
${LangFileString} yabUnpacking "正在釋放安裝包…"
${LangFileString} yabExtracting "正在解壓縮程式檔案…"
${LangFileString} yabCopying "正在寫入程式檔案…"
${LangFileString} yabRegistering "正在儲存安裝資訊…"
${LangFileString} yabInstalled "安裝完成"
${LangFileString} yabFinishing "正在完成安裝…"
${LangFileString} yabRemoving "移除檔案"
${LangFileString} yabRemoved "解除安裝完成"
${LangFileString} yabCannotDeleteOnUpdate "更新時不能刪除應用程式資料。"
${LangFileString} yabDeleteRequiresSilent "請於無訊息移除時使用刪除資料參數，或在移除介面取消保留應用程式資料。"
