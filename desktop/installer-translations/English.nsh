!insertmacro LANGFILE_EXT "${YAB_TRANSLATION_LANGUAGE}"

${LangFileString} yabWelcomeTitle "Welcome to ${YAB_DISPLAY_NAME} Setup"
${LangFileString} yabOpenApp "Open YAB"
${LangFileString} yabUnWelcomeTitle "Welcome to ${YAB_DISPLAY_NAME} Uninstall"
${LangFileString} yabDirectoryTitle "Installation folder"
${LangFileString} yabDirectorySubtitle "Choose the folder in which to install ${YAB_DISPLAY_NAME}."
${LangFileString} yabDirectoryText "Setup will install ${YAB_DISPLAY_NAME} in the following folder. To install in a different folder, click Browse and select another folder. $(^ClickInstall)"
${LangFileString} yabDirectoryGroup "Destination Folder"
${LangFileString} yabDirectoryInvalid "Enter a complete installation folder path."
${LangFileString} yabDataTitle "Application data"
${LangFileString} yabDataSubtitle "Choose whether to keep your settings and runtime data."
${LangFileString} yabKeepData "Keep application data (recommended)"
${LangFileString} yabKeepDataText "Keep settings, logs, runtimes and backups for a future installation.$\r$\n$\r$\nUncheck to remove this installation's settings and default YAB application data."
${LangFileString} yabChecking "Checking whether YAB is running..."
${LangFileString} yabInstalling "Installing"
${LangFileString} yabPreparing "Preparing installation..."
${LangFileString} yabUnpacking "Unpacking the installation archive..."
${LangFileString} yabExtracting "Extracting program files..."
${LangFileString} yabCopying "Writing program files..."
${LangFileString} yabRegistering "Saving installation information..."
${LangFileString} yabInstalled "Installation complete"
${LangFileString} yabFinishing "Finishing installation..."
${LangFileString} yabRemoving "Remove files"
${LangFileString} yabRemoved "Uninstall complete"
${LangFileString} yabCannotDeleteOnUpdate "Application data cannot be deleted during an update."
${LangFileString} yabDeleteRequiresSilent "Use --delete-app-data only with /S, or choose the option in the uninstaller."
