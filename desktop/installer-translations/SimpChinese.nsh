!insertmacro LANGFILE_EXT "${YAB_TRANSLATION_LANGUAGE}"

${LangFileString} yabWelcomeTitle "欢迎使用 ${YAB_DISPLAY_NAME} 安装向导"
${LangFileString} yabUnWelcomeTitle "欢迎使用 ${YAB_DISPLAY_NAME} 解除安装向导"
${LangFileString} yabDirectoryTitle "选择安装位置"
${LangFileString} yabDirectorySubtitle "选择 ${YAB_DISPLAY_NAME} 的安装文件夹。"
${LangFileString} yabDirectoryText "安装程序将把 ${YAB_DISPLAY_NAME} 安装到以下目录。要安装到另一个目录，请点击 [浏览(B)...] 并选择其他的文件夹。$(^ClickInstall)"
${LangFileString} yabDirectoryGroup "安装目录"
${LangFileString} yabDirectoryInvalid "请填写完整的安装目录。"
${LangFileString} yabDataTitle "应用数据"
${LangFileString} yabDataSubtitle "选择卸载后是否保留配置和运行数据。"
${LangFileString} yabKeepData "保留应用数据（推荐）"
${LangFileString} yabKeepDataText "保留配置、日志、运行环境和备份，重新安装后可继续使用。$\r$\n$\r$\n取消勾选将全部删除。"
${LangFileString} yabChecking "正在检查 YAB 运行状态…"
${LangFileString} yabInstalling "正在安装"
${LangFileString} yabFinishing "正在完成安装…"
${LangFileString} yabRemoving "删除文件"
${LangFileString} yabCannotDeleteOnUpdate "更新时不能删除应用数据。"
${LangFileString} yabDeleteRequiresSilent "请在静默卸载时使用删除数据参数，或在卸载界面取消保留应用数据。"
