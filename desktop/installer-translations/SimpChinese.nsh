!insertmacro LANGFILE_EXT "${YAB_TRANSLATION_LANGUAGE}"

${LangFileString} yabWelcomeTitle "欢迎使用 ${YAB_DISPLAY_NAME} 安装向导"
${LangFileString} yabOpenApp "打开 YAB"
${LangFileString} yabReinstall "重新安装(&I)"
${LangFileString} yabChooseInstallFolder "请在下一步确认安装位置。"
${LangFileString} yabReplacePersonal "使用当前账户授权安装时，会移除个人版程序，配置保留在原位置。使用其他管理员账户授权时，个人版也会保留。"
${LangFileString} yabUnWelcomeTitle "欢迎使用 ${YAB_DISPLAY_NAME} 解除安装向导"
${LangFileString} yabDirectoryTitle "选择安装位置"
${LangFileString} yabDirectorySubtitle "选择 ${YAB_DISPLAY_NAME} 的安装文件夹。"
${LangFileString} yabDirectoryText "安装程序将把 ${YAB_DISPLAY_NAME} 安装到以下目录。要安装到另一个目录，请点击 [浏览(B)...] 并选择其他的文件夹。$(^ClickInstall)"
${LangFileString} yabDirectoryGroup "安装目录"
${LangFileString} yabDirectoryInvalid "请填写完整的安装目录。"
${LangFileString} yabDirectoryNotWritable "无法写入安装目录：$INSTDIR$\r$\n请确认该目录可写，或选择其他目录。"
${LangFileString} yabDataTitle "应用数据"
${LangFileString} yabUninstallLocationLabel "卸载位置"
${LangFileString} yabUnregisteredUninstall "在请求的范围内找不到 YAB 的安装记录，无法确定要卸载的目录。"
${LangFileString} yabDataSubtitle "选择卸载后是否保留配置和运行数据。"
${LangFileString} yabKeepData "保留应用数据（推荐）"
${LangFileString} yabKeepDataText "保留配置、日志和运行数据，重新安装后可继续使用。$\r$\n$\r$\n取消勾选将清理发起卸载的账户使用的默认数据，包括该账户的安装内数据、用户数据和旧版共用数据。其他账户的数据会保留。"
${LangFileString} yabChecking "正在检查 YAB 运行状态…"
${LangFileString} yabInstalling "正在安装"
${LangFileString} yabPreparing "正在准备安装…"
${LangFileString} yabUnpacking "正在释放安装包…"
${LangFileString} yabExtracting "正在解压程序文件…"
${LangFileString} yabCopying "正在写入程序文件…"
${LangFileString} yabCopyFailed "写入程序文件失败。$\r$\n点击「重试」，安装器会尝试直接解压覆盖。"
${LangFileString} yabCopyDebugLogLabel "诊断日志："
${LangFileString} yabRegistering "正在保存安装信息…"
${LangFileString} yabInstalled "安装完成"
${LangFileString} yabFinishing "正在完成安装…"
${LangFileString} yabRemoving "删除文件"
${LangFileString} yabRemoved "卸载完成"
${LangFileString} yabCannotDeleteOnUpdate "更新时不能删除应用数据。"
${LangFileString} yabDeleteRequiresSilent "请在静默卸载时使用删除数据参数，或在卸载界面取消保留应用数据。"
